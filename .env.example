# =====================================================================
# 青芽 SproutLearn · 环境变量模板
# 复制为仓库根 .env 后填写，禁止把真实 .env 提交到仓库。
# 所有业务数值必须来自这里或配置表，代码禁止硬编码。
# =====================================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_NAME=青芽 SproutLearn
APP_VERSION=0.1.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REQUEST_ID_HEADER=X-Request-Id
SLOW_REQUEST_MS=1000

# ---------- 安全 ----------
SECRET_KEY=<PLACEHOLDER>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720
SESSION_IDLE_MINUTES=30
BCRYPT_ROUNDS=12

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=sproutlearn
MYSQL_PASSWORD=<PLACEHOLDER>
# Compose 用 env_file 注入 MySQL root 密码；建议与 MYSQL_PASSWORD 填写相同值
MYSQL_ROOT_PASSWORD=<PLACEHOLDER>
MYSQL_DATABASE=sproutlearn
MYSQL_POOL_SIZE=10
MYSQL_POOL_MAX_OVERFLOW=20

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<PLACEHOLDER>
REDIS_DB=0

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=<PLACEHOLDER>
QDRANT_COLLECTION=kb_chunks
VECTOR_DIM=1024
VECTOR_DISTANCE=Cosine
VECTOR_INDEX_ENABLED=false

# ---------- 上传与解析 ----------
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=50
MAX_TOTAL_UPLOAD_MB=100
UPLOAD_ALLOWED_EXT=pdf,doc,docx,ppt,pptx,md,txt
PDF_MIN_TEXT_CHARS=50
PARSER_TIMEOUT_SECONDS=120
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_FILES_PER_REQUEST=20

# ---------- 编码生成 ----------
CLASS_CODE_LENGTH=6
MAX_CLASSES_PER_TEACHER=10
TEXT_FIELD_MAX_LEN=80
INVITE_CODE_LENGTH=6
INVITE_CODE_TTL_MINUTES=0
CODE_RETRY_LIMIT=3
BIND_CODE_LENGTH=8
BIND_CODE_TTL_SECONDS=600
BIND_MAX_ATTEMPTS=5
BIND_ATTEMPT_TTL_SECONDS=600

# ---------- 分页 ----------
PAGINATION_DEFAULT_SIZE=10
PAGINATION_MAX_SIZE=50

# ---------- 限流 ----------
RATE_LIMIT_LOGIN=5/300
RATE_LIMIT_JOIN=10/3600
RATE_LIMIT_INVITE_RESET=3/3600
RATE_LIMIT_UPLOAD=20/3600

# ---------- 机器人（M2+，本阶段仅占位） ----------
BOT_SHARED_SECRET=<PLACEHOLDER>

# ---------- 模型路由（M2 判分内核；真实值只写本机 .env） ----------
# 顺序即降级顺序；某厂商 key 留空即跳过该跳
LLM_CHAIN=amd,zhipu,deepseek
LLM_TIMEOUT_SECONDS=15
LLM_EXPLAIN_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# AMD 免费池（链首）
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_MODEL=DeepSeek-V4-Flash

# 智谱 GLM（链中）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_MODEL_FALLBACK=glm-4.7-flash

# DeepSeek（链尾，计费；当前 key 无效则留空跳过）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter（指挥官已冻结，不参与 LLM_CHAIN；仅探针使用）
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Jev 判分内核（独立链路，不并入 LLM_CHAIN）
JEV_BASE_URL=https://jev.showapi.com
JEV_GATEWAY_URL=https://route.showapi.com/3627-1
JEV_APPKEY=
JEV_MODEL=JevK5-V0.3
JEV_TIMEOUT_SECONDS=8
JEV_FALLBACK_TO_LLM=true
JEV_ENABLED=true

# M2B 题库导入与判分并发
QUESTION_IMPORT_MAX_MB=10
QUESTION_IMPORT_MAX_ROWS=500
QUESTION_IMPORT_TOKEN_TTL_SECONDS=1800
GRADING_CONCURRENCY=5

# 兼容旧键（M1 遗留，新代码不读取）
LLM_API_KEY=<PLACEHOLDER>
LLM_BASE_URL=<PLACEHOLDER>
LLM_MODEL=<PLACEHOLDER>

# ---------- 其他 ----------
TZ=Asia/Shanghai
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S

# M2 学生邮箱注册（QQ SMTP）：验证码发信用，本地 .env 填真实值，仓库只留占位
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
BOT_SECRET_KEY=<PLACEHOLDER>
